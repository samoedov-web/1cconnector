```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.pyc.swp
*.so
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing
.coverage
coverage/
htmlcov/
.pytest_cache/
.hypothesis/

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env
.env.local
*.env.*

# Build artifacts
build/
dist/
*.egg
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Migrations (if not already tracked)
migrations/versions/*.py
```