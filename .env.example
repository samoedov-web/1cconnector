# Скопируйте в .env и заполните под клиента.

POSTGRES_PASSWORD=change-me

# Токен HTTP-обмена с расширением 1С (X-Exchange-Token)
CONNECTOR_ONEC_EXCHANGE_TOKEN=change-me

# Интервал опроса индексера, сек
CONNECTOR_INDEXER_POLL_INTERVAL=60

# Источники данных: минимум два на сеть для кросс-проверки (п. 3 ТЗ)
TRON_SOURCE_1_URL=https://api.trongrid.io
TRON_SOURCE_1_API_KEY=
TRON_SOURCE_2_URL=
TRON_SOURCE_2_API_KEY=

ETH_SOURCE_1_URL=
ETH_SOURCE_2_URL=
