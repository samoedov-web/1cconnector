# Скопируйте в .env и заполните под клиента.

POSTGRES_PASSWORD=change-me

# Токен HTTP-обмена с расширением 1С (X-Exchange-Token)
CONNECTOR_ONEC_EXCHANGE_TOKEN=change-me

# Ключ подписи токенов веб-панели (обязателен для входа в панель)
CONNECTOR_SECRET_KEY=change-me-long-random

# Пароль первого администратора: учётка admin создаётся при старте,
# если пользователей ещё нет; после первого входа переменную можно убрать
CONNECTOR_ADMIN_PASSWORD=change-me

# Интервал опроса индексера, сек
CONNECTOR_INDEXER_POLL_INTERVAL=60

# Webhook алертов мониторинга (POST JSON); пусто — только журнал в панели
CONNECTOR_ALERT_WEBHOOK_URL=

# Заполнять справочники сетей/активов по умолчанию при пустой базе
CONNECTOR_SEED_DEFAULTS=true

# Депозитарная сверка (docs/reconciliation.md): off | shadow | active
# off — слой выключен (по умолчанию); shadow — сверка без влияния на учёт
CONNECTOR_CUSTODY_MODE=off
CONNECTOR_CUSTODY_SOURCE_ID=mock-depo
CONNECTOR_CUSTODY_FIXTURES_DIR=fixtures/custody

# Лицензия (docs/licensing.md): файл выдаёт вендор; без файла — деморежим
# (1 юрлицо, 1 кошелёк). Открытый ключ вендора для проверки подписи:
CONNECTOR_LICENSE_PATH=license.json
CONNECTOR_LICENSE_PUBLIC_KEY=

# Источники данных: минимум два на сеть для кросс-проверки (п. 3 ТЗ)
TRON_SOURCE_1_URL=https://api.trongrid.io
TRON_SOURCE_1_API_KEY=
TRON_SOURCE_2_URL=
TRON_SOURCE_2_API_KEY=

ETH_SOURCE_1_URL=
ETH_SOURCE_2_URL=
