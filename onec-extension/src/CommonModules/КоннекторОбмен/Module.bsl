// Расширение «Коннектор Блокчейн» для 1С:Бухгалтерия 3.0.
// Общий серверный модуль обмена с коннектором.
//
// Точка входа — СинхронизацияСКоннектором(): вызывается регламентным
// заданием раз в N минут. Полный цикл:
//   1) выгрузка справочников (контрагенты, договоры ВЭД, счета) → POST /sync;
//   2) загрузка проектов документов → GET /documents;
//   3) создание документов по КлючуОбмена (идемпотентно, без дублей);
//   4) подтверждение → POST /documents/ack.
//
// Настройки (константы расширения): КоннекторАдрес, КоннекторТокен,
// КоннекторАвтопроведение. Состав объектов — см. onec-extension/STRUCTURE.md.

#Область ПрограммныйИнтерфейс

// Основная процедура регламентного задания.
Процедура СинхронизацияСКоннектором() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ВыгрузитьСправочники();
	ЗагрузитьДокументы();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область HTTP

Функция Соединение()

	Адрес = Константы.КоннекторАдрес.Получить(); // например, https://connector.local:8000
	ЧастиАдреса = РазобратьАдрес(Адрес);

	ЗащищенноеСоединение = Неопределено;
	Если ЧастиАдреса.Схема = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Возврат Новый HTTPСоединение(
		ЧастиАдреса.Сервер, ЧастиАдреса.Порт,,,,, ЗащищенноеСоединение);

КонецФункции

Функция РазобратьАдрес(Адрес)

	Результат = Новый Структура("Схема, Сервер, Порт");
	СтруктураURI = РазложитьСтрокуURI(Адрес); // см. БСП: ОбщегоНазначения.СтруктураURI
	Результат.Схема  = СтруктураURI.Схема;
	Результат.Сервер = СтруктураURI.Хост;
	Если ПустаяСтрока(СтруктураURI.Порт) Тогда
		Результат.Порт = ?(Результат.Схема = "https", 443, 80);
	Иначе
		Результат.Порт = Число(СтруктураURI.Порт);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Заголовки()

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Exchange-Token", Константы.КоннекторТокен.Получить());
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Возврат Заголовки;

КонецФункции

Функция ВыполнитьЗапрос(Метод, Ресурс, ТелоJSON = Неопределено)

	Запрос = Новый HTTPЗапрос(Ресурс, Заголовки());
	Если ТелоJSON <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);
	КонецЕсли;

	Если Метод = "GET" Тогда
		Ответ = Соединение().Получить(Запрос);
	Иначе
		Ответ = Соединение().ОтправитьДляОбработки(Запрос);
	КонецЕсли;

	Если Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон(
			"Коннектор вернул ошибку %1 на %2 %3: %4",
			Ответ.КодСостояния, Метод, Ресурс, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

	Возврат Ответ.ПолучитьТелоКакСтроку();

КонецФункции

Функция ПрочитатьОтветJSON(Строка)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Строка);
	Данные = ПрочитатьJSON(Чтение, Ложь); // структуры: ключи — латиница
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

Функция ЗаписатьВJSON(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область ВыгрузкаСправочников

// Выгружает в коннектор контрагентов, договоры ВЭД и открытые счета.
// Отбор — по добавленному расширением признаку РасчетыЦифровойВалютой
// на справочнике «Договоры контрагентов».
Процедура ВыгрузитьСправочники()

	Пакет = Новый Структура;
	Пакет.Вставить("counterparties", Новый Массив);
	Пакет.Вставить("contracts", Новый Массив);
	Пакет.Вставить("invoices", Новый Массив);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.Владелец КАК Контрагент,
	|	Договоры.Номер КАК Номер,
	|	Договоры.УчетныйНомерВЭД КАК УчетныйНомер,
	|	Договоры.ВалютаВзаиморасчетов.Код КАК ВалютаКод
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.РасчетыЦифровойВалютой
	|	И НЕ Договоры.ПометкаУдаления");

	Выборка = Запрос.Выполнить().Выбрать();
	ВыгруженныеКонтрагенты = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		Если ВыгруженныеКонтрагенты[Выборка.Контрагент] = Неопределено Тогда
			Контрагент = Новый Структура;
			Контрагент.Вставить("onec_ref", GUID(Выборка.Контрагент));
			Контрагент.Вставить("name", Строка(Выборка.Контрагент));
			Пакет.counterparties.Добавить(Контрагент);
			ВыгруженныеКонтрагенты.Вставить(Выборка.Контрагент, Истина);
		КонецЕсли;

		Договор = Новый Структура;
		Договор.Вставить("onec_ref", GUID(Выборка.Договор));
		Договор.Вставить("counterparty_ref", GUID(Выборка.Контрагент));
		Договор.Вставить("number", Выборка.Номер);
		Договор.Вставить("registration_number", Строка(Выборка.УчетныйНомер));
		Договор.Вставить("currency", Выборка.ВалютаКод);
		Пакет.contracts.Добавить(Договор);

		ДобавитьОткрытыеСчетаДоговора(Пакет.invoices, Выборка.Договор);

	КонецЦикла;

	Если Пакет.counterparties.Количество() = 0 Тогда
		Возврат; // выгружать нечего
	КонецЕсли;

	ВыполнитьЗапрос("POST", "/api/v1/onec/sync", ЗаписатьВJSON(Пакет));

КонецПроцедуры

// Счета с непогашенным остатком по договору. Источник счетов зависит от
// учётной политики клиента (Счёт покупателю / Счёт от поставщика / заказы) —
// уточняется при внедрении; ниже вариант для «Счёт покупателю».
Процедура ДобавитьОткрытыеСчетаДоговора(МассивСчетов, Договор)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Счет,
	|	Счета.Номер КАК Номер,
	|	Счета.СуммаДокумента КАК Сумма,
	|	Счета.ВалютаДокумента.Код КАК ВалютаКод,
	|	Счета.Дата КАК ДатаСчета,
	|	Счета.СрокОплаты КАК СрокОплаты
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.ДоговорКонтрагента = &Договор
	|	И Счета.Проведен
	|	И НЕ Счета.Оплачен");
	Запрос.УстановитьПараметр("Договор", Договор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счет = Новый Структура;
		Счет.Вставить("onec_ref", GUID(Выборка.Счет));
		Счет.Вставить("contract_ref", GUID(Договор));
		Счет.Вставить("number", Выборка.Номер);
		Счет.Вставить("amount", Формат(Выборка.Сумма, "ЧРД=.; ЧГ=0"));
		Счет.Вставить("currency", Выборка.ВалютаКод);
		Счет.Вставить("due_from", XMLСтрока(Выборка.ДатаСчета));
		Счет.Вставить("due_to", XMLСтрока(Выборка.СрокОплаты));
		МассивСчетов.Добавить(Счет);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаДокументов

Процедура ЗагрузитьДокументы()

	ОтветСтрокой = ВыполнитьЗапрос("GET", "/api/v1/onec/documents?status=draft&limit=100");
	Проекты = ПрочитатьОтветJSON(ОтветСтрокой);

	Подтверждения = Новый Массив;

	Для Каждого Проект Из Проекты Цикл
		ДокументСсылка = НайтиИлиСоздатьДокумент(Проект);
		Если ДокументСсылка <> Неопределено Тогда
			Подтверждение = Новый Структура;
			Подтверждение.Вставить("idempotency_key", Проект.idempotency_key);
			Подтверждение.Вставить("onec_ref", GUID(ДокументСсылка));
			Подтверждения.Добавить(Подтверждение);
		КонецЕсли;
	КонецЦикла;

	Если Подтверждения.Количество() > 0 Тогда
		ВыполнитьЗапрос("POST", "/api/v1/onec/documents/ack", ЗаписатьВJSON(Подтверждения));
	КонецЕсли;

КонецПроцедуры

// Идемпотентное создание: документ ищется по КлючуОбмена; найденный
// возвращается как есть (повторная выгрузка не создаёт дублей).
Функция НайтиИлиСоздатьДокумент(Проект)

	// Режим shadow depository-спеки: результаты сверки — информационная
	// запись в регистр сведений, НЕ бухгалтерский документ.
	Если Проект.doc_type = "reconciliation_info" Тогда
		ЗаписатьРезультатСверки(Проект);
		Возврат Неопределено; // ack не требуется — регистр перезаписываем по ключу
	КонецЕсли;

	ТипДокумента = ТипДокументаПоКоду(Проект.doc_type);
	Если ТипДокумента = Неопределено Тогда
		ЗаписьЖурналаРегистрации("КоннекторОбмен",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Неизвестный тип документа: " + Проект.doc_type);
		Возврат Неопределено;
	КонецЕсли;

	Существующий = НайтиПоКлючуОбмена(ТипДокумента, Проект.idempotency_key);
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;

	Документ = Документы[ТипДокумента].СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.КлючОбмена = Проект.idempotency_key;
	ЗаполнитьРеквизитыДокумента(Документ, Проект);

	РежимЗаписи = ?(Константы.КоннекторАвтопроведение.Получить(),
		РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Документ.Записать(РежимЗаписи);

	Возврат Документ.Ссылка;

КонецФункции

Функция ТипДокументаПоКоду(КодТипа)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("receipt", "ПоступлениеЦифровойВалюты");
	Соответствие.Вставить("disposal", "ВыбытиеЦифровойВалюты");
	Соответствие.Вставить("fee", "КомиссияБлокчейнСети");
	Возврат Соответствие[КодТипа];

КонецФункции

Функция НайтиПоКлючуОбмена(ИмяДокумента, Ключ)

	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Док.Ссылка ИЗ Документ.%1 КАК Док
	|ГДЕ Док.КлючОбмена = &Ключ", ИмяДокумента));
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

Процедура ЗаполнитьРеквизитыДокумента(Документ, Проект)

	Документ.ХэшТранзакции   = Проект.tx_hash;
	Документ.БлокчейнСеть    = Справочники.БлокчейнСети.НайтиПоКоду(Проект.network);
	Документ.Криптоактив     = Справочники.Криптоактивы.НайтиПоНаименованию(Проект.asset);
	Документ.Количество      = ЧислоИзСтроки(Проект.amount);
	Документ.МоментОперации  = ДатаИзISO(Проект.block_time);

	Если Проект.Свойство("rate") И Проект.rate <> Неопределено Тогда
		Документ.КурсВРубли     = ЧислоИзСтроки(Проект.rate.asset_to_rub);
		Документ.ИсточникКурса  = Проект.rate.source;
	КонецЕсли;
	Если Проект.Свойство("amount_rub") Тогда
		Документ.СуммаРуб = ЧислоИзСтроки(Проект.amount_rub);
	КонецЕсли;

	// Привязки: коннектор передаёт GUID объектов 1С (counterparty_ref,
	// contract_ref, invoice_ref); пустой GUID — привязка не установлена,
	// бухгалтер заполнит вручную по *_name/*_number.
	Если Проект.Свойство("allocations") Тогда
		Для Каждого Привязка Из Проект.allocations Цикл
			Строка = Документ.Привязки.Добавить();
			Строка.Сумма = ЧислоИзСтроки(Привязка.amount);
			Если Не ПустаяСтрока(Привязка.counterparty_ref) Тогда
				Строка.Контрагент = Справочники.Контрагенты.ПолучитьСсылку(
					Новый УникальныйИдентификатор(Привязка.counterparty_ref));
			КонецЕсли;
			Если Не ПустаяСтрока(Привязка.contract_ref) Тогда
				Строка.Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(
					Новый УникальныйИдентификатор(Привязка.contract_ref));
			КонецЕсли;
			Строка.НомерИнвойса = Привязка.invoice_number;
		КонецЦикла;
	КонецЕсли;

	// Расшифровка ФИФО для выбытия — в регистр партий при проведении.
	Если Проект.Свойство("fifo_lines") Тогда
		Для Каждого Партия Из Проект.fifo_lines Цикл
			СтрокаПартии = Документ.ПартииСписания.Добавить();
			СтрокаПартии.ИдентификаторПартии = Партия.lot_id;
			СтрокаПартии.Количество          = ЧислоИзСтроки(Партия.quantity);
			СтрокаПартии.СебестоимостьРуб    = ЧислоИзСтроки(Партия.cost_rub);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

// Информационная запись сверки с депозитарием (режим shadow).
// Никаких проводок: только регистр сведений для просмотра бухгалтером.
Процедура ЗаписатьРезультатСверки(Проект)

	НаборЗаписей = РегистрыСведений.РезультатыСверкиСДепозитарием.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЗапуска.Установить(Проект.run_id);

	Для Каждого Расхождение Из Проект.discrepancies Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Период              = ТекущаяДатаСеанса();
		Запись.ИдентификаторЗапуска = Проект.run_id;
		Запись.ИсточникВыписки     = Проект.source_id;
		Запись.ПериодС             = ДатаИзISO(Проект.period_from);
		Запись.ПериодПо            = ДатаИзISO(Проект.period_to);
		Запись.Статус              = Расхождение.status;
		Запись.Правило             = Расхождение.rule;
		Запись.Пояснение           = СтрокаПояснения(Расхождение);
	КонецЦикла;

	НаборЗаписей.Записать(Истина); // перезапись по ключу — идемпотентно

КонецПроцедуры

Функция СтрокаПояснения(Расхождение)
	Если Расхождение.detail.Свойство("reason") Тогда
		Возврат Расхождение.detail.reason;
	КонецЕсли;
	Возврат "";
КонецФункции

#Область Утилиты

Функция GUID(Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ЧислоИзСтроки(Значение)
	Возврат Число(СтрЗаменить(Значение, ".", СимволыРазделителиДробнойЧасти()));
КонецФункции

Функция СимволыРазделителиДробнойЧасти()
	Возврат Формат(1.1, "ЧДЦ=1")[1]; // разделитель текущей локали сеанса
КонецФункции

Функция ДатаИзISO(Значение)
	Возврат ПрочитатьДатуJSON(Значение, ФорматДатыJSON.ISO);
КонецФункции

#КонецОбласти

#КонецОбласти
